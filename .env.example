# SmarterContact Audit Automation - Environment Variables
# Copy this to .env and fill in your values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Firebase API Key — required for SmarterContact authentication (scraper/firebase_auth.py)
# Get from Firebase Console → Project Settings → Web API Key
FIREBASE_API_KEY=your_firebase_api_key_here

# Encryption key for agent credentials (auto-generated on first run)
CREDENTIALS_KEY=

# Browser Settings
MAX_PARALLEL_WORKERS=5
HEADLESS_MODE=true
SCREENSHOT_ON_ERROR=true

# Anti-Detection
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=5
MAX_RETRIES=3

# Database — required. Postgres connection string (asyncpg / psycopg compatible).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/texting_audit

# Optional: admin token for state-mutating dashboard routes. When set, every
# POST/PUT/DELETE under /api/* requires the same value in the X-Admin-Token
# header. Leave unset for local dev (gate disabled).
ADMIN_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Alert Email (Phase 4)
ALERT_EMAIL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Timezone for audit dates, shift math, and all stored timestamps.
TZ=America/New_York

# ─── Work Shift ───────────────────────────────────────────────────────────────
# The team's staffed hours, in the TZ above. Every elapsed-time audit rule counts
# only minutes inside this window, so agents are never flagged for overnight or
# weekend gaps. Defaults are 10:00 AM - 7:00 PM ET, Monday-Friday.
SHIFT_START_HOUR=10
SHIFT_END_HOUR=19
# Weekdays worked, Mon=0 ... Sun=6. Use 0,1,2,3,4,5,6 for seven-day coverage.
SHIFT_DAYS=0,1,2,3,4

# ─── Response-time flag (F17) ─────────────────────────────────────────────────
# Thresholds are in SHIFT minutes, not wall-clock minutes.
RESPONSE_TIME_YELLOW_MIN=10
RESPONSE_TIME_RED_MIN=15
RESPONSE_TIME_CRITICAL_MIN=25
# Script Adherence points deducted at each tier.
RESPONSE_TIME_PENALTY_YELLOW=8
RESPONSE_TIME_PENALTY_RED=15
RESPONSE_TIME_PENALTY_CRITICAL=25
